# Base URL for the Deutchezz backend API (all endpoints are under /api/v1 on the server).
VITE_API_URL=http://localhost:5144/api/v1

# When "true" the app runs against an in-memory/localStorage mock adapter that
# mimics the real backend (see src/api/services/mock). Set to "false" to hit VITE_API_URL.
VITE_USE_MOCKS=true
